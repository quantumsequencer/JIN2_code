
QWidget {
    background-color: #B8CCDD;
    color: #233B53;
    font-family: "Segoe UI", "Yu Gothic UI", sans-serif;
    font-size: 12px;
}
QMainWindow { background-color: #B8CCDD; }
QPushButton {
    background-color: #D2E1ED;
    color: #29465D;
    border: 1px solid #9AB6CA;
    border-radius: 12px;
    padding: 6px 10px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #DEF4FC;
    border-color: #0088AB;
    color: #233B53;
}
QPushButton:pressed { background-color: #BFEAF7; }
QPushButton:disabled {
    background-color: #E7EFF5;
    color: #788D9D;
    border-color: #D7E3EB;
}
QLineEdit, QPlainTextEdit, QTableWidget, QSpinBox {
    background-color: #D2E1ED;
    color: #233B53;
    border: 1px solid #9AB6CA;
    border-radius: 5px;
    padding: 5px;
    selection-background-color: #167A8B;
}
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border-color: #0088AB;
}
QGroupBox {
    background-color: #D2E1ED;
    border: 1px solid #8CAAC1;
    border-radius: 16px;
    margin-top: 9px;
    padding-top: 8px;
    font-weight: 600;
    color: #42647C;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical {
    background: #D2E1ED;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #A6C6D9;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QProgressBar {
    border: none;
    background-color: #D2E1ED;
    border-radius: 2px;
}
QProgressBar::chunk { background-color: #0088AB; border-radius: 2px; }
QToolTip {
    background-color: #D2E1ED;
    color: #233B53;
    border: 1px solid #0088AB;
    padding: 4px;
}

QLabel#title { font-size: 20px; font-weight: 700; }
QLabel#badge { color: #07694E; background: #DCF3EA; border: 1px solid #A8DBC9; padding: 8px 12px; border-radius: 12px; }
QLabel#banner { color: #42647C; background: #E0EFF8; padding: 10px; border-radius: 12px; }
QLabel#meter { color: #007C9B; font-size: 27px; font-weight: 600; }
QLabel#muted { color: #5D7487; font-size: 11px; }
QPushButton#primary { background: #007F9D; border-color: #0088AB; color: white; font-weight: 600; }
QPushButton#primary:disabled { background: #DBEAF1; border-color: #8CAAC1; color: #788D9D; }
QPushButton#danger { background: #D63F55; border-color: #C12D43; color: #FFFFFF; }
QPushButton#danger:disabled { background: #F3E5E9; border-color: #E7CCD3; color: #A87581; }
QComboBox { background: #D2E1ED; border: 1px solid #9AB6CA; border-radius: 5px; padding: 5px; }
QProgressBar { min-height: 18px; text-align: center; }
QGroupBox { padding: 10px; padding-top: 15px; }
QSplitter::handle { background: #8CAAC1; width: 1px; }

QLabel { background: transparent; }
QLabel#title { color: #234D67; font-size: 22px; }
QProgressBar { color: #233B53; background: #DAEBF5; border-radius: 9px; min-height: 20px; }
QProgressBar::chunk { background: #6DC8E2; border-radius: 9px; }
QDoubleSpinBox { background: #D2E1ED; color: #233B53; border: 1px solid #9AB6CA; border-radius: 8px; padding: 5px; }
QAbstractItemView { background: #D2E1ED; color: #233B53; selection-background-color: #CDEFF9; selection-color: #233B53; }
QHeaderView::section { background: #DCEEF8; color: #29465D; padding: 6px; border: none; }
QScrollArea { border: none; }
QPushButton#danger { color: white; }
QPushButton#danger:disabled { color: #A87581; }
