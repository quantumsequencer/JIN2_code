<Window
    x:Class="Sony.Jin.Gateway.Views.LiveCurrentGraphWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:prop="clr-namespace:Sony.Jin.Gateway.Properties"
    xmlns:vm="clr-namespace:Sony.Jin.Gateway.ViewModels"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:LiveCurrentGraphViewModel}"
    Style="{StaticResource {x:Type Window}}"
    Title="{x:Static prop:Resources.GraphWindow_TitleLiveCurrent}"
    Visibility="Visible"
    Width="700" Height="400" MinWidth="500" MinHeight="400">

    <i:Interaction.Behaviors>
        <sp:WindowCancelClosingBehavior AltVisibility="Collapsed" />
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0" Grid.Column="1" Margin="8,8"
            Content="{x:Static prop:Resources.GraphWindow_ButtonSnap}"
            ToolTip="{x:Static prop:Resources.GraphWindow_ToolTipSnap}"
            IsEnabled="{Binding SnapAvailable.Value, Mode=OneWay}"
            Command="{Binding SnapCommand}"
            CommandParameter="{Binding GraphSource.Value}" />
        <local:CurrentGraphGrid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" />
    </Grid>
</Window>
