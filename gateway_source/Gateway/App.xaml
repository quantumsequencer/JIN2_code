<Application
    x:Class="Sony.Jin.Gateway.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    ShutdownMode="OnMainWindowClose"
    StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}">
            <Setter Property="Background" Value="#F8F8F8" />
            <Setter Property="sp:WindowHelper.SavePosition" Value="true" />
            <Style.Triggers>
                <Trigger Property="ResizeMode" Value="NoResize">
                    <!-- sp:WindowHelper.SavePosition=True 動作がアプリ終了後の DPI 設定変更を完全には考慮しないため、ResizeMode=NoResize としているウィンドウのパーツが見切れたり、間延びする症状への対策 -->
                    <Setter Property="sp:WindowHelper.RestoreDefaultWindowSize" Value="True" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
