<UserControl
    x:Class="Sony.Jin.Gateway.Views.CurrentGraphGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:prop="clr-namespace:Sony.Jin.Gateway.Properties"
    xmlns:vm="clr-namespace:Sony.Jin.Gateway.ViewModels"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:CurrentGraphViewModel}"
    d:Background="White" d:DesignWidth="800" d:DesignHeight="450" >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendLIne" TargetType="{x:Type Line}">
            <Setter Property="X1" Value="0" />
            <Setter Property="X2" Value="92" />
            <Setter Property="Y1" Value="0" />
            <Setter Property="Y2" Value="0" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <sp:MessageTrigger MessageName="{x:Static vm:CurrentGraphViewModel.MessageVisibilityRequest}" Source="{Binding Messenger, Mode=OneTime}">
            <sp:WindowVisibilityAction InvisibleValue="Collapsed" />
        </sp:MessageTrigger>
        <sp:MessageTrigger MessageName="{x:Static vm:CurrentGraphViewModel.MessageCaptureRequest}" Source="{Binding Messenger, Mode=OneTime}">
            <sp:CaptureWindowAction ResultCommand="{Binding ReceiveCaptureResultCommand}" />
        </sp:MessageTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <local:GraphGrid
                Grid.Column="1" Grid.Row="1"
                GraphSource="{Binding GraphSource.Value, Mode=OneWay}"
                XAxis="{Binding XAxis.Value, Mode=OneWay}"
                YAxis="{Binding YAxis.Value, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Column="1" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static prop:Resources.GraphWindow_LabelData}" />
            <Line
                Grid.Column="1" Grid.Row="0"
                Style="{StaticResource LegendLIne}"
                d:Stroke="#2078B5" Stroke="{Binding ValueBrush, Mode=OneTime}" />

            <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static prop:Resources.GraphWindow_LabelMedian}" />
            <Line
                Grid.Column="1" Grid.Row="1"
                Style="{StaticResource LegendLIne}"
                d:Stroke="#FF0E0E" Stroke="{Binding MedianBrush, Mode=OneTime}" />

            <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static prop:Resources.GraphWindow_LabelRMS}" />
            <Line
                Grid.Column="1" Grid.Row="2"
                Style="{StaticResource LegendLIne}"
                d:Stroke="#FFB53B" Stroke="{Binding RmsBrush, Mode=OneTime}" />

            <TextBlock Grid.Column="0" Grid.Row="3" Text="{x:Static prop:Resources.GraphWindow_LabelDataType}" />
            <TextBox Grid.Column="1" Grid.Row="3" IsReadOnly="True" Text="{Binding DataTypeText.Value, Mode=OneWay}" />

            <Separator Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" Height="20" Margin="4,0" />

            <TextBlock Grid.Column="0" Grid.Row="5" Text="{x:Static prop:Resources.GraphWindow_LabelCurrentLow}" />
            <ComboBox
                Grid.Column="1" Grid.Row="5" DisplayMemberPath="DisplayName"
                ItemsSource="{Binding LowModeYAxisCollection}"
                SelectedItem="{Binding SelectedLowModeYAxis.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="0" Grid.Row="6" Text="{x:Static prop:Resources.GraphWindow_LabelCurrentHigh}" />
            <ComboBox
                Grid.Column="1" Grid.Row="6" DisplayMemberPath="DisplayName"
                ItemsSource="{Binding HighModeYAxisCollection}"
                SelectedItem="{Binding SelectedHighModeYAxis.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="0" Grid.Row="7" Text="{x:Static prop:Resources.GraphWindow_LabelTime}" />
            <ComboBox
                Grid.Column="1" Grid.Row="7" DisplayMemberPath="DisplayName"
                ItemsSource="{Binding XAxisCollection}"
                SelectedItem="{Binding SelectedXAxis.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="8" Margin="16,4,6,0" HorizontalAlignment="Right" Orientation="Horizontal"
                Visibility="{Binding SnapGraph, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="2,4" />
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="22" />
                    </Style>
                </StackPanel.Resources>
                <Button
                    IsEnabled="{Binding PageLeftAvailable.Value, Mode=OneWay}"
                    Command="{Binding MoveXAxisCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xEB9E;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.CommandParameter>
                        <sys:Int32>-10</sys:Int32>
                    </Button.CommandParameter>
                </Button>
                <Button
                    IsEnabled="{Binding DivisionLeftAvailable.Value, Mode=OneWay}"
                    Command="{Binding MoveXAxisCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xE768;" FontSize="10" RenderTransformOrigin="0.5,0.5" Style="{StaticResource IconTextBlock}">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button.Content>
                    <Button.CommandParameter>
                        <sys:Int32>-1</sys:Int32>
                    </Button.CommandParameter>
                </Button>
                <Button
                    Margin="12,4,2,4"
                    IsEnabled="{Binding DivisionRightAvailable.Value, Mode=OneWay}"
                    Command="{Binding MoveXAxisCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xE768;" FontSize="10" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.CommandParameter>
                        <sys:Int32>1</sys:Int32>
                    </Button.CommandParameter>
                </Button>
                <Button
                    IsEnabled="{Binding PageRightAvailable.Value, Mode=OneWay}"
                    Command="{Binding MoveXAxisCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xEB9D;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.CommandParameter>
                        <sys:Int32>10</sys:Int32>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="10" Margin="16,4,6,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="24" Height="24" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding SnapGraph, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{x:Static prop:Resources.GraphWindow_ToolTipDelete}"
                    Command="{Binding RemoveSelectedGraphSourceCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xE74D;" FontSize="16"  Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                </Button>
                <Button
                    Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="{x:Static prop:Resources.GraphWindow_ToolTipCapture}">
                    <Button.Content>
                        <TextBlock Text="&#xE722;" FontSize="16" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <sp:SaveFileDialogAction
                                Filter="{x:Static prop:Resources.GraphWindow_FileDialogFilterCapture}"
                                AcceptCommand="{Binding CaptureCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
