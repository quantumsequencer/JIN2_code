<Window
    x:Class="Sony.Jin.Gateway.Views.LoopbackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:data="clr-namespace:Sony.Jin.Gateway.Data"
    xmlns:prop="clr-namespace:Sony.Jin.Gateway.Properties"
    xmlns:vm="clr-namespace:Sony.Jin.Gateway.ViewModels"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:LoopbackViewModel}"
    Style="{StaticResource {x:Type Window}}"
    Title="{x:Static prop:Resources.LoopbackWindow_Title}"
    ResizeMode="NoResize" Height="660" Width="400">

    <Window.Resources>
        <sp:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <sp:WindowCancelClosingBehavior AltVisibility="Collapsed" />
    </i:Interaction.Behaviors>

    <i:Interaction.Triggers>
        <sp:MessageTrigger MessageName="{x:Static vm:LoopbackViewModel.MessageVisibilityRequest}" Source="{Binding Messenger, Mode=OneTime}">
            <sp:WindowVisibilityAction InvisibleValue="Collapsed" />
        </sp:MessageTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="{x:Static prop:Resources.LoopbackWindow_LabelReceivePortFrame}" />
            <Button
                Grid.Column="2" Grid.Row="0"
                Command="{Binding SetReceiveStateCommand}"
                CommandParameter="{Binding ReceiveState.Value, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="{x:Static prop:Resources.LoopbackWindow_ButtonStart}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReceiveState.Value}" Value="True">
                                <Setter Property="Content" Value="{x:Static prop:Resources.LoopbackWindow_ButtonStop}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Static prop:Resources.LoopbackWindow_LabelHostSerialNumber}" />
            <TextBox Grid.Column="2" Grid.Row="1" IsReadOnly="True" Text="{Binding HostSerialNumber.Value, Mode=OneWay}" />

            <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Static prop:Resources.LoopbackWindow_LabelHostDataType}" />
            <TextBox Grid.Column="2" Grid.Row="2" IsReadOnly="True" Text="{Binding HostDataType.Value, Mode=OneWay, StringFormat='{}{0:X4}h'}" />

            <TextBlock Grid.Column="1" Grid.Row="3" Text="{x:Static prop:Resources.LoopbackWindow_LabelHostFrameLength}" />
            <TextBox Grid.Column="2" Grid.Row="3" IsReadOnly="True" Text="{Binding HostFrameLength.Value, Mode=OneWay}" />

            <TextBlock Grid.Column="1" Grid.Row="4" Text="{x:Static prop:Resources.LoopbackWindow_LabelHostReceiveCount}" />
            <Grid Grid.Column="2" Grid.Row="4" Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="2,4" IsReadOnly="True" Text="{Binding HostReceiveCount.Value, Mode=OneWay}" />
                <Button Grid.Column="1" Margin="2,4" Width="20" Command="{Binding ResetHostReceiveCountCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xE75C;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                </Button>
            </Grid>

            <TextBlock Grid.Column="1" Grid.Row="5" Text="{x:Static prop:Resources.LoopbackWindow_LabelDebugResponse}" />
            <TextBox Grid.Column="2" Grid.Row="5" IsReadOnly="True" Text="{Binding DebugText.Value, Mode=OneWay}" />

            <TextBlock Grid.Column="1" Grid.Row="6" Text="{x:Static prop:Resources.LoopbackWindow_LabelLogMessage}" />
            <TextBox Grid.Column="2" Grid.Row="6" IsReadOnly="True" Text="{Binding LogText.Value, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" Margin="4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Text="{x:Static prop:Resources.LoopbackWindow_LabelTransmitControlMessage}" />

            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Static prop:Resources.LoopbackWindow_LabelNop}" />
            <Button
                Grid.Column="3" Grid.Row="1"
                Content="{x:Static prop:Resources.LoopbackWindow_ButtonTransmit}"
                Command="{Binding TransmitAppControlCommand}"
                CommandParameter="{x:Static data:ControlType.Nop}"/>

            <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Static prop:Resources.LoopbackWindow_LabelSnapCurrentGraph}" />
            <Button
                Grid.Column="3" Grid.Row="2"
                Content="{x:Static prop:Resources.LoopbackWindow_ButtonTransmit}"
                Command="{Binding TransmitAppControlCommand}"
                CommandParameter="{x:Static data:ControlType.SnapCurrentGraph}"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Text="{x:Static prop:Resources.LoopbackWindow_LabelSnapHardwareGraph}" />
            <Button
                Grid.Column="3" Grid.Row="3"
                Content="{x:Static prop:Resources.LoopbackWindow_ButtonTransmit}"
                Command="{Binding TransmitAppControlCommand}"
                CommandParameter="{x:Static data:ControlType.SnapHardwareGraph}"/>

            <TextBlock Grid.Column="1" Grid.Row="4" Text="{x:Static prop:Resources.LoopbackWindow_LabelPrintMessage}" />
            <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="PrintMessageTextBox" Grid.Column="2" Margin="2,4" />
                <Button
                    Grid.Column="3" Margin="2,4" Width="20"
                    Command="{Binding TransmitPrintControlCommand}"
                    CommandParameter="{Binding Text, ElementName=PrintMessageTextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PrintMessageTextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static prop:Resources.LoopbackWindow_LabelDebugCommand}" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="0" />
                <TextBox
                    x:Name="DebugCommand0TextBox" Grid.Column="2" Grid.Row="0"  Margin="2,4"
                    Text="{Binding DebugCommandEntry0.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="0" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand0TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand0TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="1" Text="1" />
                <TextBox
                    x:Name="DebugCommand1TextBox" Grid.Column="2" Grid.Row="1"  Margin="2,4"
                    Text="{Binding DebugCommandEntry1.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="1" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand1TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand1TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="2" Text="2" />
                <TextBox
                    x:Name="DebugCommand2TextBox" Grid.Column="2" Grid.Row="2"  Margin="2,4"
                    Text="{Binding DebugCommandEntry2.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="2" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand2TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand2TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="3" Text="3" />
                <TextBox
                    x:Name="DebugCommand3TextBox" Grid.Column="2" Grid.Row="3"  Margin="2,4"
                    Text="{Binding DebugCommandEntry3.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="3" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand3TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand3TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="4" Text="4" />
                <TextBox
                    x:Name="DebugCommand4TextBox" Grid.Column="2" Grid.Row="4"  Margin="2,4"
                    Text="{Binding DebugCommandEntry4.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="4" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand4TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand4TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="5" Text="5" />
                <TextBox
                    x:Name="DebugCommand5TextBox" Grid.Column="2" Grid.Row="5"  Margin="2,4"
                    Text="{Binding DebugCommandEntry5.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="5" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand5TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand5TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="6" Text="6" />
                <TextBox
                    x:Name="DebugCommand6TextBox" Grid.Column="2" Grid.Row="6"  Margin="2,4"
                    Text="{Binding DebugCommandEntry6.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="6" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand6TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand6TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="7" Text="7" />
                <TextBox
                    x:Name="DebugCommand7TextBox" Grid.Column="2" Grid.Row="7"  Margin="2,4"
                    Text="{Binding DebugCommandEntry7.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="7" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand7TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand7TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="8" Text="8" />
                <TextBox
                    x:Name="DebugCommand8TextBox" Grid.Column="2" Grid.Row="8"  Margin="2,4"
                    Text="{Binding DebugCommandEntry8.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="8" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand8TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand8TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="1" Grid.Row="9" Text="9" />
                <TextBox
                    x:Name="DebugCommand9TextBox" Grid.Column="2" Grid.Row="9"  Margin="2,4"
                    Text="{Binding DebugCommandEntry9.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3" Grid.Row="9" Margin="2,4" Width="20"
                    Command="{Binding TransmitDebugControlCommand}"
                    CommandParameter="{Binding Text, ElementName=DebugCommand9TextBox}">
                    <Button.Content>
                        <TextBlock Text="&#xE724;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DebugCommand9TextBox}" Value="">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,0" Padding="0,0">
            <TextBlock Margin="4,0,0,0" Padding="0,1,0,0" FontSize="10" Text="&#xEA3B;">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextBlock}">
                        <Setter Property="Foreground" Value="Red" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SubHostReceiverAvailable.Value}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,0,2,0" Text="{x:Static prop:Resources.LoopbackWindow_LabelSubHostSocket}" />

            <TextBlock Margin="4,0,0,0" Padding="0,1,0,0" FontSize="10" Text="&#xEA3B;">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextBlock}">
                        <Setter Property="Foreground" Value="Red" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SubDebugReceiverAvailable.Value}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,0,2,0" Text="{x:Static prop:Resources.LoopbackWindow_LabelSubDebugSocket}" />

            <TextBlock Margin="4,0,0,0" Padding="0,1,0,0" FontSize="10" Text="&#xEA3B;">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextBlock}">
                        <Setter Property="Foreground" Value="Red" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SubLogReceiverAvailable.Value}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,0,2,0" Text="{x:Static prop:Resources.LoopbackWindow_LabelSubLogSocket}" />
            
            <TextBlock Margin="4,0,0,0" Padding="0,1,0,0" FontSize="10" Text="&#xEA3B;">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconTextBlock}">
                        <Setter Property="Foreground" Value="Red" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PushTransmitterAvailable.Value}" Value="True">
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,0,2,0" Text="{x:Static prop:Resources.LoopbackWindow_LabelPushSocket}" />
        </StatusBar>
    </Grid>
</Window>
