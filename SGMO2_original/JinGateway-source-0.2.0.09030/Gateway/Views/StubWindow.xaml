<Window
    x:Class="Sony.Jin.Gateway.Views.StubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:data="clr-namespace:Sony.Jin.Gateway.Data"
    xmlns:prop="clr-namespace:Sony.Jin.Gateway.Properties"
    xmlns:vm="clr-namespace:Sony.Jin.Gateway.ViewModels"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StubViewModel}"
    Style="{StaticResource {x:Type Window}}"
    Title="{x:Static prop:Resources.StubWindow_Title}"
    ResizeMode="NoResize" Height="566" Width="460">

    <Window.Resources>
        <sp:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <sp:WindowCancelClosingBehavior AltVisibility="Collapsed" />
    </i:Interaction.Behaviors>

    <i:Interaction.Triggers>
        <sp:MessageTrigger MessageName="{x:Static vm:StubViewModel.MessageVisibilityRequest}" Source="{Binding Messenger, Mode=OneTime}">
            <sp:WindowVisibilityAction InvisibleValue="Collapsed" />
        </sp:MessageTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,4" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Text="{x:Static prop:Resources.StubWindow_LabelReceiveHostPortFrame}" />
            <Button
                Grid.Column="4" Grid.Row="0"
                Command="{Binding SetHostReceiveStateCommand}"
                CommandParameter="{Binding HostReceiveState.Value, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="{x:Static prop:Resources.StubWindow_ButtonStart}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HostReceiveState.Value}" Value="True">
                                <Setter Property="Content" Value="{x:Static prop:Resources.StubWindow_ButtonStop}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Static prop:Resources.StubWindow_LabelFullDataLogDirectory}" />
            <RadioButton
                Grid.Column="2" Grid.Row="1"
                IsChecked="{Binding UseHostFullDataLog.Value, Mode=OneWay}"
                Command="{Binding SetHostFrameSourceCommand}"
                CommandParameter="{x:Static data:HostPortFrameSourceType.FullDataLog}" />
            <Grid
                Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1" Margin="2,0"
                IsEnabled="{Binding UseHostFullDataLog.Value, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="2,4" IsReadOnly="True" Text="{Binding HostFullDataLogDirectory.Value, Mode=OneWay}" />
                <Button Grid.Column="1" Margin="2,4" Width="20">
                    <Button.Content>
                        <TextBlock Text="&#xED25;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <sp:OpenFolderDialogAction AcceptCommand="{Binding SetHostFullDataLogDirectoryCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>

            <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Static prop:Resources.StubWindow_LabelHardwareDataLogFile}" />
            <RadioButton
                Grid.Column="2" Grid.Row="2"
                IsChecked="{Binding UseHostHardwareLog.Value, Mode=OneWay}"
                Command="{Binding SetHostFrameSourceCommand}"
                CommandParameter="{x:Static data:HostPortFrameSourceType.HardwareLog}" />
            <Grid
                Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2" Margin="2,0"
                IsEnabled="{Binding UseHostHardwareLog.Value, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="2,4" IsReadOnly="True" Text="{Binding HostHardwareLogFile.Value, Mode=OneWay}" />
                <Button Grid.Column="1" Margin="2,4" Width="20">
                    <Button.Content>
                        <TextBlock Text="&#xED25;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <sp:OpenFileDialogAction
                                Filter="{x:Static prop:Resources.StubWindow_FileDialogFilterHardwareLog}"
                                AcceptCommand="{Binding SetHostHardwareLogFileCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>

            <TextBlock Grid.Column="1" Grid.Row="3" Text="{x:Static prop:Resources.StubWindow_LabelDataType}" />
            <RadioButton
                Grid.Column="2" Grid.Row="3"
                IsChecked="{Binding UseHostFrameGenerator.Value, Mode=OneWay}"
                Command="{Binding SetHostFrameSourceCommand}"
                CommandParameter="{x:Static data:HostPortFrameSourceType.FrameGenerator}" />
            <ComboBox
                Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="3" DisplayMemberPath="Title"
                ItemsSource="{Binding HostDataTypeItems}"
                SelectedItem="{Binding SelectedHostDataTypeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Style>
                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HostReceiveState.Value}" Value="False" />
                                    <Condition Binding="{Binding UseHostFrameGenerator.Value}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock Grid.Column="1" Grid.Row="4" Text="{x:Static prop:Resources.StubWindow_LabelFrameSize}" />
            <ComboBox
                Grid.Column="4" Grid.Row="4" DisplayMemberPath="Title"
                ItemsSource="{Binding HostFrameSizeItems}"
                SelectedItem="{Binding SelectedHostFrameSizeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Style>
                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedHostDataTypeItem.Value.Value}" Value="{x:Static data:HostPortDataType.Diag}" />
                                    <Condition Binding="{Binding HostReceiveState.Value}" Value="False" />
                                    <Condition Binding="{Binding UseHostFrameGenerator.Value}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock Grid.Column="1" Grid.Row="5" Text="{x:Static prop:Resources.StubWindow_LabelFrameInterval}" />
            <ComboBox
                Grid.Column="4" Grid.Row="5" DisplayMemberPath="Title"
                ItemsSource="{Binding HostFrameIntervalItems}"
                SelectedItem="{Binding SelectedHostFrameIntervalItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Style>
                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedHostDataTypeItem.Value.Value}" Value="{x:Static data:HostPortDataType.Diag}" />
                                    <Condition Binding="{Binding HostReceiveState.Value}" Value="False" />
                                    <Condition Binding="{Binding UseHostFrameGenerator.Value}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock Grid.Column="1" Grid.Row="6" Text="{x:Static prop:Resources.StubWindow_LabelSerialNumber}" />
            <TextBox Grid.Column="4" Grid.Row="6">
                <TextBox.Text>
                    <Binding Path="HostSerialNumber.Value" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <sp:UInt32Rule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBlock Grid.Column="1" Grid.Row="7" Text="{x:Static prop:Resources.StubWindow_LabelReceiveCount}" />
            <Grid Grid.Column="4" Grid.Row="7" Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="2,4" IsReadOnly="True" Text="{Binding HostReceiveCount.Value, Mode=OneWay}" />
                <Button Grid.Column="1" Margin="2,4" Width="20" Command="{Binding ResetHostReceiveCountCommand}">
                    <Button.Content>
                        <TextBlock Text="&#xE75C;" Style="{StaticResource IconTextBlock}" />
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>

        <Grid Margin="4,4" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="{x:Static prop:Resources.StubWindow_LabelReceiveDebugPortFrame}" />
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Static prop:Resources.StubWindow_LabelInsertResponse}" />
            <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1">
                <TextBox.InputBindings>
                    <KeyBinding
                        Gesture="Return"
                        Command="{Binding InsertDebugResponseCommand}"
                        CommandParameter="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}" />
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Static prop:Resources.StubWindow_LabelErrorCommand}" />
            <WrapPanel Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2">
                <!-- CheckBox.Content の文字列にある "_" がアクセスキーとしてエスケープされるため TextBlock で明示的に文字列表示する。 -->
                <CheckBox IsChecked="{Binding DebugDdEpBiasResult.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}">
                    <CheckBox.Content>
                        <TextBlock Text="{x:Static prop:Resources.StubWindow_LabelDdEpBias}" />
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox IsChecked="{Binding DebugDdEpEpResult.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}">
                    <CheckBox.Content>
                        <TextBlock Text="{x:Static prop:Resources.StubWindow_LabelDdEpEp}" />
                    </CheckBox.Content>
                </CheckBox>
                <CheckBox IsChecked="{Binding DebugMwAcGo0Result.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}">
                    <CheckBox.Content>
                        <TextBlock Text="{x:Static prop:Resources.StubWindow_LabelMwAcGo0}" />
                    </CheckBox.Content>
                </CheckBox>
            </WrapPanel>

            <TextBlock Grid.Column="1" Grid.Row="3" Text="{x:Static prop:Resources.StubWindow_LabelResultCode}" />

            <TextBlock Grid.Column="2" Grid.Row="3" Text="{x:Static prop:Resources.StubWindow_LabelSvInfoSenderStart}" />
            <ComboBox
                Grid.Column="3" Grid.Row="3" Margin="4,2" DisplayMemberPath="Title"
                ItemsSource="{Binding DebugResultCodeItems}"
                SelectedItem="{Binding SelectedDebugSvInfoSenderStartResultCodeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Grid.Row="4" Text="{x:Static prop:Resources.StubWindow_LabelSvInfoSenderStop}" />
            <ComboBox
                Grid.Column="3" Grid.Row="4" Margin="4,2" DisplayMemberPath="Title"
                ItemsSource="{Binding DebugResultCodeItems}"
                SelectedItem="{Binding SelectedDebugSvInfoSenderStopResultCodeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Grid.Row="5" Text="{x:Static prop:Resources.StubWindow_LabelMcbjSet}" />
            <ComboBox
                Grid.Column="3" Grid.Row="5" Margin="4,2" DisplayMemberPath="Title"
                ItemsSource="{Binding DebugResultCodeItems}"
                SelectedItem="{Binding SelectedDebugMcbjSetResultCodeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Grid.Row="6" Text="{x:Static prop:Resources.StubWindow_LabelAszSet}" />
            <ComboBox
                Grid.Column="3" Grid.Row="6" Margin="4,2" DisplayMemberPath="Title"
                ItemsSource="{Binding DebugResultCodeItems}"
                SelectedItem="{Binding SelectedDebugAszSetResultCodeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="1" Grid.Row="7" Text="{x:Static prop:Resources.StubWindow_LabelMcbjAsz}" />

            <TextBlock Grid.Column="2" Grid.Row="7" Text="{x:Static prop:Resources.StubWindow_LabelMcbjExecutionTime}" />
            <ComboBox
                Grid.Column="3" Grid.Row="7" Margin="4,2" DisplayMemberPath="Title"
                ItemsSource="{Binding DebugExecutionTimeItems}"
                SelectedItem="{Binding SelectedDebugMcbjSubcommandTimeItem.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="2" Grid.Row="8" Margin="4,4" IsHitTestVisible="False" Focusable="False"
                Content="{x:Static prop:Resources.StubWindow_LabelMcbjRunning}"
                IsChecked="{Binding DebugMcbjRunning.Value, Mode=OneWay}" />
            <Button
                Grid.Column="3" Grid.Row="8" Margin="4,4"
                Content="{x:Static prop:Resources.StubWindow_LabelMcbjRaiseError}"
                IsEnabled="{Binding DebugMcbjRunning.Value, Mode=OneWay}"
                Command="{Binding RaiseDebugMcbjErrorCommand}" />
        </Grid>

        <Grid Margin="4,4" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Text="{x:Static prop:Resources.StubWindow_LabelReceiveLogPortFrame}" />
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Static prop:Resources.StubWindow_LabelInsertMessage}" />
            <TextBox Grid.Column="2" Grid.Row="1">
                <TextBox.InputBindings>
                    <KeyBinding
                        Gesture="Return"
                        Command="{Binding InsertLogMessageCommand}"
                        CommandParameter="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </Grid>
</Window>
