<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Web.Extensions" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Web.Script.Serialization" #>
<#@ output extension=".g.cs" #>
<#
    // ===== 設定 =====
    const string JsonFileName = "../resources.json";
    const string Namespace    = "Sony.Jin.Gateway.Properties";
    const string ClassName    = "Resources";

    // C# 予約語（プロパティ名として使えないもの）
    var reservedWords = new HashSet<string>(StringComparer.Ordinal)
    {
        "abstract","as","base","bool","break","byte","case","catch","char","checked",
        "class","const","continue","decimal","default","delegate","do","double","else",
        "enum","event","explicit","extern","false","finally","fixed","float","for",
        "foreach","goto","if","implicit","in","int","interface","internal","is","lock",
        "long","namespace","new","null","object","operator","out","override","params",
        "private","protected","public","readonly","ref","return","sbyte","sealed",
        "short","sizeof","stackalloc","static","string","struct","switch","this",
        "throw","true","try","typeof","uint","ulong","unchecked","unsafe","ushort",
        "using","virtual","void","volatile","while"
    };

    // C# 識別子の正規表現（先頭は文字か_、以降は文字/数字/_）
    var identifierRegex = new Regex(@"^[A-Za-z_][A-Za-z0-9_]*$", RegexOptions.Compiled);

    // ===== 読み込み =====
    var jsonPath = Host.ResolvePath(JsonFileName);
    Dictionary<string, string> dict = null;
    string loadError = null;

    try
    {
        if (!File.Exists(jsonPath))
        {
            loadError = "resources.json が見つかりません: " + jsonPath;
        }
        else
        {
            var json = File.ReadAllText(jsonPath);
            var serializer = new JavaScriptSerializer();
            dict = serializer.Deserialize<Dictionary<string, string>>(json);
            if (dict == null) dict = new Dictionary<string, string>();
        }
    }
    catch (Exception ex)
    {
        loadError = "resources.json 読み込みエラー: " + ex.Message;
    }

    // ===== 分類 =====
    var validEntries   = new List<KeyValuePair<string, string>>();
    var invalidEntries = new List<KeyValuePair<string, string>>(); // 不正キー
    var duplicateKeys  = new List<string>();                        // 重複（辞書上は最後の値が残る）
    var usedNames      = new HashSet<string>(StringComparer.Ordinal);

    if (dict != null)
    {
        foreach (var kv in dict)
        {
            var key = kv.Key ?? "";

            // 1) 空チェック
            if (string.IsNullOrEmpty(key))
            {
                invalidEntries.Add(new KeyValuePair<string, string>("(empty)", "キーが空です"));
                continue;
            }

            // 2) 識別子パターンチェック
            if (!identifierRegex.IsMatch(key))
            {
                invalidEntries.Add(new KeyValuePair<string, string>(key, "C#識別子として不正な文字を含む"));
                continue;
            }

            // 3) 予約語チェック
            if (reservedWords.Contains(key))
            {
                invalidEntries.Add(new KeyValuePair<string, string>(key, "C#予約語"));
                continue;
            }

            // 4) 重複（大文字小文字違いも含めて衝突するとプロパティ定義が失敗）
            if (!usedNames.Add(key))
            {
                duplicateKeys.Add(key);
                continue;
            }

            validEntries.Add(kv);
        }
    }

    // ===== 警告出力（ビルド出力ウィンドウに表示） =====
    if (loadError != null)
    {
        Warning(loadError);
    }
    foreach (var e in invalidEntries)
    {
        Warning(string.Format("[Resources.tt] 不正キーをスキップ: '{0}' 理由: {1}", e.Key, e.Value));
    }
    foreach (var k in duplicateKeys)
    {
        Warning(string.Format("[Resources.tt] 重複キーをスキップ: '{0}'", k));
    }
#>
// <auto-generated />
// このファイルは Resources.tt により自動生成されています。手動で編集しないでください。
// Source: <#= JsonFileName #>

namespace <#= Namespace #>
{
    /// <summary>
    /// resources.json から自動生成された文字列リソース。
    /// 値は実行時に JsonResourceManager 経由で取得されます。
    /// </summary>
    public static class <#= ClassName #>
    {
<#
    if (loadError != null)
    {
#>
        // 警告: <#= loadError #>
<#
    }

    foreach (var kv in validEntries)
    {
        var key = kv.Key;
        var value = kv.Value ?? "";
        // XMLコメント用のエスケープ
        var comment = value
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\r", "")
            .Replace("\n", " ");
#>
        /// <summary>
        /// <#= comment #>
        /// </summary>
        public static string <#= key #> => JsonResourceManager.Instance["<#= key #>"];

<#
    }

    if (invalidEntries.Count > 0 || duplicateKeys.Count > 0)
    {
#>
        // ===== スキップされたキー =====
<#
        foreach (var e in invalidEntries)
        {
#>
        // SKIP (invalid): <#= e.Key #>  -- <#= e.Value #>
<#
        }
        foreach (var k in duplicateKeys)
        {
#>
        // SKIP (duplicate): <#= k #>
<#
        }
    }
#>
    }
}