<Window
    x:Class="Sony.Jin.Gateway.Views.OptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:Sony.Jin.Presentation;assembly=Sony.Jin.Presentation"
    xmlns:data="clr-namespace:Sony.Jin.Gateway.Data"
    xmlns:prop="clr-namespace:Sony.Jin.Gateway.Properties"
    xmlns:vm="clr-namespace:Sony.Jin.Gateway.ViewModels"
    xmlns:local="clr-namespace:Sony.Jin.Gateway.Views"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OptionsViewModel}"
    Style="{StaticResource {x:Type Window}}"
    Title="{x:Static prop:Resources.OptionsWindow_Title}"
    ResizeMode="NoResize" Height="280" Width="500">

    <Window.Resources>
        <sp:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <sp:WindowCancelClosingBehavior AltVisibility="Collapsed" />
    </i:Interaction.Behaviors>

    <i:Interaction.Triggers>
        <sp:MessageTrigger MessageName="{x:Static vm:OptionsViewModel.MessageVisibilityRequest}" Source="{Binding Messenger, Mode=OneTime}">
            <sp:WindowVisibilityAction InvisibleValue="Collapsed" />
        </sp:MessageTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Padding="8,8" Header="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryGroup}">
            <StackPanel>
                <RadioButton
                    Margin="0,2"
                    IsChecked="{Binding IsChecked, ElementName=RecordDirectoryChooseRadioButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                    Content="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryAuto}">
                </RadioButton>
                <Grid Margin="20,0,0,0" IsEnabled="{Binding ChooseDirectory.Value, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="0,2,4,2" Text="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryBase}"/>
                    <TextBox Grid.Column="1" Margin="2,2" IsReadOnly="True" Text="{Binding BaseDirectory.Value, Mode=OneWay}" />
                    <Button Grid.Column="2" Margin="2,2" Width="20">
                        <Button.Content>
                            <TextBlock Text="&#xED25;" Style="{StaticResource IconTextBlock}" />
                        </Button.Content>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <sp:OpenFolderDialogAction
                                    AcceptCommand="{Binding SetBaseDirectoryCommand}"
                                    CancelCommand="{Binding SetBaseDirectoryCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                </Grid>
                <TextBlock
                    Margin="20,2,0,10" FontSize="11" Foreground="Gray"
                    Text="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryAutoExplanation}" />

                <RadioButton
                    x:Name="RecordDirectoryChooseRadioButton" Margin="0,2"
                    IsChecked="{Binding ChooseDirectory.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Content="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryChoose}" />
                <TextBlock
                    Margin="20,2,0,2" FontSize="11" Foreground="Gray"
                    Text="{x:Static prop:Resources.OptionsWindow_LabelRecordDirectoryChooseExplanation}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Padding="8,8" Header="{x:Static prop:Resources.OptionsWindow_LabelRecordDataSelectionGroup}">
            <StackPanel Orientation="Vertical">
                <CheckBox
                    Content="{x:Static prop:Resources.OptionsWindow_LabelRecordDataSelectionFullData}"
                    IsChecked="{Binding RecordCurrentData.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Content="{x:Static prop:Resources.OptionsWindow_LabelRecordDataSelectionHardwareData}"
                    IsChecked="{Binding RecordHardwareData.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
